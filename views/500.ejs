<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Error</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-[#FDFBF7] grid place-items-center min-h-screen text-[#5B1E31]">
  <div class="text-center max-w-md"><p class="font-serif text-5xl font-bold">Oven error 🔥</p><p class="mt-2 text-sm opacity-70"><%= (typeof error !== 'undefined' && error && error.message) ? error.message : 'Something went wrong.' %></p><a href="/" class="underline">Back home</a></div>
</body>
</html>
