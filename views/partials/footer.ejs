<!-- Cart drawer -->
<div id="cartDrawer" class="drawer">
  <div class="drawer-panel">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-serif text-2xl font-bold text-burgundy">Your Cart 🛒</h3>
      <button onclick="toggleDrawer('cartDrawer')" class="text-2xl leading-none">×</button>
    </div>
    <div id="cartItems" class="space-y-3 flex-1 overflow-y-auto"></div>
    <div class="border-t border-burgundy/15 mt-4 pt-4 space-y-3">
      <div class="grid grid-cols-2 gap-2 text-sm">
        <input id="custName" placeholder="Your name" class="input" />
        <input id="custPhone" placeholder="Phone" class="input" />
      </div>
      <input id="custAddress" placeholder="Delivery address (Kilakarai)" class="input" />
      <div class="flex justify-between font-semibold text-lg">
        <span>Total</span><span id="cartTotal">₹0</span>
      </div>
      <button onclick="checkoutWhatsApp()" class="w-full bg-[#25D366] hover:brightness-95 text-white font-bold py-3 rounded-full">Order via WhatsApp</button>
      <button onclick="clearCart()" class="w-full text-sm underline opacity-70">Clear cart</button>
    </div>
  </div>
</div>

<!-- Wishlist drawer -->
<div id="wishlistDrawer" class="drawer">
  <div class="drawer-panel">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-serif text-2xl font-bold text-burgundy">Wishlist ❤️</h3>
      <button onclick="toggleDrawer('wishlistDrawer')" class="text-2xl leading-none">×</button>
    </div>
    <div id="wishItems" class="space-y-3"></div>
  </div>
</div>

